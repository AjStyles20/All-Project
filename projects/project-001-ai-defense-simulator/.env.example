# Project 001 local prototype configuration
# This file contains no credential. Copy values into your process environment or an untracked .env only if your launcher loads it.

P001_LOCAL_HOST=127.0.0.1
P001_LOCAL_PORT=8000
P001_OPENAI_ENABLED=0

# Optional local database override. Leave unset to use data/project001.db.
# P001_DATABASE_PATH=C:\path\to\project001.db

# Only set the following in the server process environment when intentionally enabling the provider.
# Never commit a real value.
# P001_OPENAI_API_KEY=
# P001_OPENAI_TEXT_MODEL=gpt-5.6-luna
# P001_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# P001_OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# P001_OPENAI_TTS_MODEL=gpt-4o-mini-tts
# P001_OPENAI_TTS_VOICE=alloy
# P001_OPENAI_TIMEOUT_SECONDS=20
